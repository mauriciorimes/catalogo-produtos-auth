# Banco de dados (valores batem com o docker-compose.yml)
DATABASE_URL="postgresql://admin:senha123@localhost:5433/catalogo_produtos?schema=public"

# Segredo usado para assinar os tokens JWT. Gere um valor próprio:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque_por_um_segredo_longo_e_aleatorio"

# Tempo de expiração do token (ex.: 1h, 7d)
JWT_EXPIRES_IN="7d"

# Porta da API
PORT=3001
